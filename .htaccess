# PoliLedger - cPanel Apache Configuration & Production Security Hardening
# Optimized for Next.js Static Export in /poliledger subdirectory

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /poliledger/

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect Trailing Slashes if not a folder
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # 3. Serve clean HTML URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Fallback to index.html for client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /poliledger/index.html [L]
</IfModule>

# ─── GZIP & BROTLI COMPRESSION ────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/woff font/woff2
</IfModule>

# ─── BROWSER CACHING ──────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 600 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ─── SECURITY HEADERS & DEFENSE-IN-DEPTH ───────────────────────────────
<IfModule mod_headers.c>
  # 1. Prevent MIME-sniffing
  Header set X-Content-Type-Options "nosniff"

  # 2. Clickjacking protection
  Header set X-Frame-Options "SAMEORIGIN"

  # 3. Cross-site scripting filter
  Header set X-XSS-Protection "1; mode=block"

  # 4. Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # 5. Strict Transport Security (HSTS - 1 Year Preloaded)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 6. Restrict hardware API access
  Header set Permissions-Policy "camera=(), microphone=(), payment=()"

  # 7. Content Security Policy (CSP)
  Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; img-src 'self' https: data: blob:; font-src 'self' https: data:; frame-ancestors 'self';"
</IfModule>

# ─── ACCESS RESTRICTIONS & FILE SHIELD ────────────────────────────────
# Deny access to hidden dotfiles (e.g. .git, .env)
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

# Block executable script execution in static directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh|bash)$">
  Require all denied
</FilesMatch>

# ─── MIME TYPES ──────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
</IfModule>

Options -Indexes
