# PoliLedger - Environment Variables
# Copy this file to .env and fill in your values

# ─── DATABASE ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/poliledger?schema=public"

# ─── AUTHENTICATION ──────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# ─── CLOUD STORAGE (Receipts) ────────────────────────────────────────
# For Google Cloud Storage:
# GCS_BUCKET_NAME="poliledger-receipts"
# GCS_PROJECT_ID="your-gcp-project"

# For local development (files stored in /public/uploads):
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=10

# ─── EMAIL (Optional) ────────────────────────────────────────────────
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# EMAIL_FROM="noreply@poliledger.app"

# ─── EXCHANGE RATES (Optional) ───────────────────────────────────────
# EXCHANGE_RATE_API_KEY="your-api-key"
# EXCHANGE_RATE_BASE_URL="https://api.exchangerate.host"

# ─── APP SETTINGS ────────────────────────────────────────────────────
DEFAULT_CURRENCY="KES"
APP_NAME="PoliLedger"
